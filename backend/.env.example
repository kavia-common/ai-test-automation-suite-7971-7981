# Copy to .env and customize as needed for the backend.

# Optional: override default SQLite database location.
# If not set, app will use sqlite:///instance/app.db
DATABASE_URL=sqlite:///instance/app.db

# Existing variables (if used by orchestrator)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=
REACT_APP_NEXT_TELEMETRY_DISABLED=
REACT_APP_ENABLE_SOURCE_MAPS=
REACT_APP_PORT=3001
REACT_APP_TRUST_PROXY=
REACT_APP_LOG_LEVEL=
REACT_APP_HEALTHCHECK_PATH=/docs
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
